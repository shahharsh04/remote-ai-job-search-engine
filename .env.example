# Copy to .env for local development. NEVER commit .env - it is gitignored.
# This project needs no API keys or secrets; the job boards are scraped
# without authentication, so there is nothing sensitive to leak here.

# Comma-separated origins allowed to call the API.
# Production: set this to your Netlify site URL, e.g.
#   ALLOWED_ORIGINS=https://your-site.netlify.app
# Local development:
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Path to the pipeline settings file.
CONFIG_PATH=config.yaml
